font=JetBrains Mono Nerd Font 9
background-color=#222222
text-color=#bbbbbb
border-color=#444444
border-size=1
border-radius=0
padding=10
margin=5
default-timeout=10000
ignore-timeout=0
max-visible=3
sort=-time
layer=overlay
anchor=top-right
width=420
height=200
icons=0
markup=1
actions=1
format=<b>%s</b>\n%b
max-icon-size=32
outer-margin=5

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=critical]
default-timeout=0

[summary~="Setup Wi-Fi"]
on-button-left=exec sh -c 'mina-notification-dismiss "Setup Wi-Fi"; foot -e impala'

[summary~="Update System"]
on-button-left=exec sh -c 'mina-notification-dismiss "Update System"; foot -e mina-update'